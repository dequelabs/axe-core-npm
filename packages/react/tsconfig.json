{
  "compilerOptions": {
    "outDir": "./dist",
    "ignoreDeprecations": "6.0",
    "strict": false,
    "types": ["react"],
    "moduleResolution": "node",
    "declaration": true,
    "sourceMap": true,
    "inlineSources": true,
    "allowJs": false,
    "module": "esnext",
    "target": "esnext",
    "lib": ["dom", "esnext"],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "exclude": ["test", "dist", "node_modules", "tsup.config.ts"]
}
